#include <Adafruit_NeoPixel.h>

#define LED_PIN 33
#define N_LEDS 30

#define LEFT_SENSOR_PIN  34
#define RIGHT_SENSOR_PIN 36

Adafruit_NeoPixel strip(N_LEDS, LED_PIN, NEO_GRB + NEO_KHZ800);

// Individuelle thresholds
const int LEFT_THRESHOLD  = 1650;
const int RIGHT_THRESHOLD = 1580;

// Difference threshold
const int DIFF_THRESHOLD  = 200;

void setup() {
  Serial.begin(115200);

  strip.begin();
  strip.setBrightness(120);
  strip.clear();
  strip.show();
}

void loop() {
  int leftValue  = analogRead(LEFT_SENSOR_PIN);
  int rightValue = analogRead(RIGHT_SENSOR_PIN);

  int diff = leftValue - rightValue;

  bool leftActive  = leftValue  > LEFT_THRESHOLD;
  bool rightActive = rightValue > RIGHT_THRESHOLD;

  Serial.print("Left: ");
  Serial.print(leftValue);
  Serial.print("   Right: ");
  Serial.print(rightValue);
  Serial.print("   Diff: ");
  Serial.println(diff);

  uint32_t color = strip.Color(255, 80, 0); // orange

  if (leftActive && rightActive) {
    if (abs(diff) < DIFF_THRESHOLD) {
      blinkHazard(color);
    } 
    else if (diff > 0) {
      blinkLeft(color);
    } 
    else {
      blinkRight(color);
    }
  }
  else if (leftActive) {
    blinkLeft(color);
  }
  else if (rightActive) {
    blinkRight(color);
  }
  else {
    strip.clear();
    strip.show();
    delay(20);
  }
}

// Venstre
void blinkLeft(uint32_t color) {
  int center = strip.numPixels() / 2;

  for (int offset = 0; offset <= center + 4; offset++) {

    if (analogRead(LEFT_SENSOR_PIN) <= LEFT_THRESHOLD) {
      strip.clear();
      strip.show();
      return;
    }

    strip.clear();

    int left = center - offset;

    for (int t = 0; t < 4; t++) {
      int pos = left + t;
      if (pos >= 0 && pos < strip.numPixels()) {
        strip.setPixelColor(pos, color);
      }
    }

    strip.show();
    delay(40);
  }

  delay(250);
  strip.clear();
  strip.show();
}

// Højre
void blinkRight(uint32_t color) {
  int center = strip.numPixels() / 2;

  for (int offset = 0; offset <= center + 4; offset++) {

    if (analogRead(RIGHT_SENSOR_PIN) <= RIGHT_THRESHOLD) {
      strip.clear();
      strip.show();
      return;
    }

    strip.clear();

    int right = center + offset;

    for (int t = 0; t < 4; t++) {
      int pos = right - t;
      if (pos >= 0 && pos < strip.numPixels()) {
        strip.setPixelColor(pos, color);
      }
    }

    strip.show();
    delay(40);
  }

  delay(250);
  strip.clear();
  strip.show();
}

// Hazard
void blinkHazard(uint32_t color) {
  int center = strip.numPixels() / 2;

  for (int offset = 0; offset <= center + 4; offset++) {

    int leftValue  = analogRead(LEFT_SENSOR_PIN);
    int rightValue = analogRead(RIGHT_SENSOR_PIN);

    if (leftValue <= LEFT_THRESHOLD || rightValue <= RIGHT_THRESHOLD) {
      strip.clear();
      strip.show();
      return;
    }

    strip.clear();

    int left  = center - offset;
    int right = center + offset;

    for (int t = 0; t < 4; t++) {
      int posL = left + t;
      int posR = right - t;

      if (posL >= 0 && posL < strip.numPixels()) {
        strip.setPixelColor(posL, color);
      }

      if (posR >= 0 && posR < strip.numPixels()) {
        strip.setPixelColor(posR, color);
      }
    }

    strip.show();
    delay(40);
  }

  delay(250);
  strip.clear();
  strip.show();
}
